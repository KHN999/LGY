# Postgres (Railway will provide this in production)
DATABASE_URL="postgresql://lgy:lgy_dev_password@localhost:5433/lgy?schema=public"

# JWT secret for own auth (generate with: openssl rand -base64 32)
JWT_SECRET="change-me-locally-never-commit-the-real-one"
JWT_EXPIRES_IN="30d"

# Cloudflare R2 (product photos)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="lgy-photos"
R2_PUBLIC_URL=""

# Backend (NestJS)
API_PORT=4000
API_URL="http://localhost:4000"
WEB_ORIGIN="http://localhost:3000"

# Shop stock policy: "allow" (default) = shop sales never block; overselling logs
# a StockException for back-office reconciliation. "block" = strict shop stock.
SHOP_OVERSELL="allow"

# Frontend (Next.js)
NEXT_PUBLIC_API_URL="http://localhost:4000"
